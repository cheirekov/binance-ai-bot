# Beginner / Futures (USD-M) - NOT production-ready
#
# This project’s futures support is experimental.
# Use at your own risk and keep TRADING_ENABLED=false for extended testing.

BINANCE_API_KEY=
BINANCE_API_SECRET=

TRADE_VENUE=futures
FUTURES_ENABLED=false
FUTURES_LEVERAGE=2
FUTURES_MARGIN_TYPE=ISOLATED

TRADING_ENABLED=false
AUTO_TRADE_ENABLED=false

# Futures universe: keep narrow for safety.
# NOTE: USD-M futures are effectively USDT-quoted; EU users who cannot use USDT should use spot with HOME_ASSET=EUR.
TRADE_UNIVERSE=
QUOTE_ASSETS=USDT
# Exclusion list is primarily for spot AUTO discovery; included here for completeness.
EXCLUDED_QUOTE_ASSETS=USDT
TRADE_DENYLIST=

AI_MODE=off
AI_AUTONOMY_PROFILE=safe
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4.1-mini
# If trading is blocked (HALT/emergency stop/daily loss cap), avoid wasting tokens:
# never: skip AI policy calls when blocked (default, recommended)
# hourly: allow at most 1/hour for monitoring summary
# always: current behavior
AI_POLICY_CALL_WHEN_BLOCKED=never

MAX_POSITION_SIZE_USDT=200
RISK_PER_TRADE_BP=50
DAILY_LOSS_CAP_PCT=3
MAX_VOLATILITY_PCT=12
MIN_QUOTE_VOLUME=10000000
# fixed: use MIN_QUOTE_VOLUME as-is
# adaptive: compute a HOME-normalized floor relative to MAX_POSITION_SIZE_USDT
MIN_QUOTE_VOLUME_MODE=fixed

PERSISTENCE_PATH=./data/state.json
PERSIST_TO_SQLITE=false
SQLITE_PATH=/app/data/bot.sqlite
BASIC_AUTH_USER=bot
BASIC_AUTH_PASS=botpass

# Trend is a per-symbol regime signal; must not globally pause trading.
RISK_TREND_GLOBAL_MODE=off
RISK_TREND_ADX_ON=25
RISK_TREND_ADX_OFF=18
