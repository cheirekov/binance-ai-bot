# Beginner / Spot
#
# 1) Copy to .env
#    cp .env.spot.basic.example .env
#
# 2) Fill BINANCE_API_KEY + BINANCE_API_SECRET (use restricted keys)
#
# 3) Keep TRADING_ENABLED=false until you are confident.

### Exchange
BINANCE_API_KEY=
BINANCE_API_SECRET=
BASIC_AUTH_USER=bot
BASIC_AUTH_PASS=botpass
### Venue
TRADE_VENUE=spot

### Safety switches
TRADING_ENABLED=false
AUTO_TRADE_ENABLED=false

### Universe (what the bot is allowed to open NEW trades on)
# Leave empty for auto-discovery.
TRADE_UNIVERSE=
# Allowed quote assets during discovery.
# Tip (EU-friendly): set QUOTE_ASSETS=AUTO to scan across multiple quotes without assuming USDT exists.
# AUTO starts from [HOME_ASSET, EUR, BTC, ETH, BNB] and filters to those with direct quote<->HOME markets.
QUOTE_ASSETS=AUTO
# Always excluded from discovery + new entries (even if discovered or in TRADE_UNIVERSE).
# EU-safe default excludes USDT.
EXCLUDED_QUOTE_ASSETS=USDT
# Always excluded from new entries (even if discovered or in TRADE_UNIVERSE)
TRADE_DENYLIST=

### AI (optional)
# off: no LLM calls
# advisory: LLM suggestions only
# gated-live: LLM proposes actions; engine executes only if all safety gates pass
AI_MODE=off
AI_AUTONOMY_PROFILE=safe

# OpenAI-compatible credentials (optional)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4.1-mini
# If trading is blocked (HALT/emergency stop/daily loss cap), avoid wasting tokens:
# never: skip AI policy calls when blocked (default, recommended)
# hourly: allow at most 1/hour for monitoring summary
# always: current behavior
AI_POLICY_CALL_WHEN_BLOCKED=never

### Core risk knobs (small account-friendly defaults)
MAX_POSITION_SIZE_USDT=200
RISK_PER_TRADE_BP=50
DAILY_LOSS_CAP_PCT=3
MAX_VOLATILITY_PCT=18
MIN_QUOTE_VOLUME=5000000
# fixed: use MIN_QUOTE_VOLUME as-is
# adaptive: compute a HOME-normalized floor relative to MAX_POSITION_SIZE_USDT
MIN_QUOTE_VOLUME_MODE=fixed

### Persistence
PERSISTENCE_PATH=./data/state.json
PERSIST_TO_SQLITE=false
SQLITE_PATH=/app/data/bot.sqlite
