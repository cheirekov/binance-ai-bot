# Spot (EU example)
#
# This is the same as the basic spot template, but explicitly excludes USDT.
#
# Usage:
#   cp .env.spot.eu.example .env
#   docker-compose up --build
#
# IMPORTANT:
# - Live trading is OFF by default.
# - Never share or print secrets.

### Exchange
BINANCE_API_KEY=
BINANCE_API_SECRET=
BASIC_AUTH_USER=bot
BASIC_AUTH_PASS=botpass

### Venue
TRADE_VENUE=spot

### Safety switches
TRADING_ENABLED=false
AUTO_TRADE_ENABLED=false

### HOME (accounting currency)
HOME_ASSET=EUR

### Universe (what the bot is allowed to open NEW trades on)
# Leave empty for auto-discovery.
TRADE_UNIVERSE=
# AUTO = scan across all quote assets on the exchange (subject to safety filters).
QUOTE_ASSETS=AUTO
# Explicitly exclude USDT (operator choice; no hardcoded bans in code).
EXCLUDED_ASSETS=USDT
# Back-compat alias (optional; leave empty when using EXCLUDED_ASSETS):
EXCLUDED_QUOTE_ASSETS=
TRADE_DENYLIST=

### AI (optional)
AI_MODE=off
AI_AUTONOMY_PROFILE=safe
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4.1-mini
AI_POLICY_CALL_WHEN_BLOCKED=never

### Core risk knobs (small account-friendly defaults)
MAX_POSITION_SIZE_USDT=200
RISK_PER_TRADE_BP=50
DAILY_LOSS_CAP_PCT=3
MAX_VOLATILITY_PCT=18
MIN_QUOTE_VOLUME=5000000
MIN_QUOTE_VOLUME_MODE=fixed

### Persistence
PERSISTENCE_PATH=./data/state.json
PERSIST_TO_SQLITE=false
SQLITE_PATH=/app/data/bot.sqlite